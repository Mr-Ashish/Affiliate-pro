# Copy to .env.networks (gitignored) and fill in only the networks you are testing.
# Docs: docs/networks/

# Awin — docs/networks/awin.md
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
AWIN_REGION_CODE=US

# Admitad — docs/networks/admitad.md
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
ADMITAD_WEBSITE_ID=
ADMITAD_REGION=US
ADMITAD_SCOPE=websites coupons_for_website advcampaigns_for_website

# TradeDoubler VOUCHERS token of type site (not type publisher / Connect) — docs/networks/tradedoubler.md
TRADEDOUBLER_VOUCHERS_TOKEN=
TRADEDOUBLER_PAGE_SIZE=10
TRADEDOUBLER_LANGUAGE_ID=

# Impact partner API — docs/networks/impact.md
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
