// Plan 1 vertical slice schema — Section 2 design
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Market {
  code          String     @id
  name          String
  defaultLocale String     @map("default_locale")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  merchants     Merchant[]
  offers        Offer[]

  @@map("markets")
}

model Merchant {
  id          String   @id @default(uuid())
  market      String
  slug        String
  name        String
  siteUrl     String   @map("site_url")
  logoUrl     String?  @map("logo_url")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  marketRef     Market         @relation(fields: [market], references: [code])
  offers        Offer[]
  postMerchants PostMerchant[]

  @@unique([market, slug])
  @@map("merchants")
}

model Offer {
  id             String    @id @default(uuid())
  market         String
  merchantId     String    @map("merchant_id")
  title          String
  description    String?
  offerType      String    @map("offer_type")
  code           String?
  affiliateUrl   String    @map("affiliate_url")
  status         String
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  isFeatured     Boolean   @default(false) @map("is_featured")
  sourceId       String    @map("source_id")
  sourceRecordId String    @map("source_record_id")
  identityKey    String    @map("identity_key")
  lastIngestedAt DateTime? @map("last_ingested_at")
  verifiedAt     DateTime? @map("verified_at")
  clickCount     Int       @default(0) @map("click_count")
  terms          String?
  isExclusive    Boolean   @default(false) @map("is_exclusive")
  discountLabel  String?   @map("discount_label")
  imageUrl       String?   @map("image_url")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  merchant       Merchant  @relation(fields: [merchantId], references: [id])
  marketRef      Market    @relation(fields: [market], references: [code])
  clicks         ClickEvent[]

  @@unique([sourceId, sourceRecordId])
  @@index([market, status, endsAt])
  @@index([merchantId, status])
  @@map("offers")
}

model ClickEvent {
  id        String   @id @default(uuid())
  offerId   String   @map("offer_id")
  createdAt DateTime @default(now()) @map("created_at")
  referrer  String?
  uaHash    String?  @map("ua_hash")
  ipHash    String?  @map("ip_hash")
  meta      Json?
  offer     Offer    @relation(fields: [offerId], references: [id])

  @@index([offerId, createdAt])
  @@map("click_events")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model Author {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  bio         String?
  avatarUrl   String?  @map("avatar_url")
  websiteUrl  String?  @map("website_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  posts       Post[]

  @@map("authors")
}

model MediaAsset {
  id          String      @id @default(uuid())
  url         String
  alt         String      @default("")
  width       Int?
  height      Int?
  mimeType    String?     @map("mime_type")
  storageKey  String?     @map("storage_key")
  createdAt   DateTime    @default(now()) @map("created_at")
  postMedia   PostMedia[]

  @@map("media_assets")
}

model Post {
  id              String         @id @default(uuid())
  slug            String         @unique
  title           String
  excerpt         String
  body            String         @db.Text
  bodyFormat      String         @default("markdown") @map("body_format")
  status          String
  isFeatured      Boolean        @default(false) @map("is_featured")
  seoTitle        String?        @map("seo_title")
  seoDescription  String?        @map("seo_description")
  authorId        String         @map("author_id")
  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  author          Author         @relation(fields: [authorId], references: [id])
  media           PostMedia[]
  merchants       PostMerchant[]
  comments        Comment[]

  @@index([status, publishedAt])
  @@index([isFeatured, status])
  @@map("posts")
}

model PostMedia {
  postId     String      @map("post_id")
  mediaId    String      @map("media_id")
  role       String
  sortOrder  Int         @default(0) @map("sort_order")
  post       Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  media      MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId, role])
  @@index([postId, role, sortOrder])
  @@map("post_media")
}

model PostMerchant {
  postId      String    @map("post_id")
  merchantId  String    @map("merchant_id")
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([postId, merchantId])
  @@index([merchantId])
  @@map("post_merchants")
}

model Comment {
  id          String    @id @default(uuid())
  postId      String    @map("post_id")
  parentId    String?   @map("parent_id")
  status      String    @default("pending")
  authorName  String    @map("author_name")
  authorEmail String    @map("author_email")
  body        String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentThread")

  @@index([postId, status, createdAt])
  @@map("comments")
}
