{
  "name": "coupon-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "smoke": "bash scripts/smoke.sh",
    "aws:staging": "bash scripts/aws/release.sh staging",
    "aws:prod": "bash scripts/aws/release.sh prod",
    "aws:push": "bash scripts/aws/build-push.sh",
    "aws:infra": "bash scripts/aws/infra-up.sh",
    "aws:infra:down": "bash scripts/aws/infra-down.sh",
    "aws:seed": "bash scripts/aws/seed.sh",
    "dev:sync": "bash scripts/dev-hot-sync.sh",
    "monitor:db": "bash scripts/monitor-db.sh",
    "monitor:app": "bash scripts/monitor-app.sh",
    "monitor:tests": "bash scripts/monitor-tests.sh",
    "agent:init": "bash scripts/agent/init-repo.sh",
    "agent:status": "bash scripts/agent/status.sh",
    "agent:branch": "bash scripts/agent/branch.sh",
    "agent:commit": "bash scripts/agent/commit.sh",
    "agent:push": "bash scripts/agent/push.sh",
    "agent:pr": "bash scripts/agent/pr.sh",
    "agent:finish-epic": "bash scripts/agent/finish-epic.sh"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "marked": "^18.0.14",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
