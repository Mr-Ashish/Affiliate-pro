# Copy to repo root as `.env.aws` (gitignored). Never commit real values.
# Used only for laptop deploys — no GitHub OIDC.

AWS_REGION=us-east-1
AWS_PROFILE=coupon-hub

# linux/arm64 = Graviton (cheaper Fargate). linux/amd64 = App Runner default / Intel.
DOCKER_PLATFORM=linux/amd64

# ECR repo URI without tag, e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com/coupon-hub
ECR_REPOSITORY=

# Public URL CloudFront / App Runner (no trailing slash)
STAGING_URL=https://staging.example.com
PROD_URL=https://example.com

# Staging DB — either a Secrets Manager name/ARN *or* DATABASE_URL_STAGING
STAGING_DATABASE_SECRET_ID=
# DATABASE_URL_STAGING=postgresql://coupon:…@….rds.amazonaws.com:5432/coupon?sslmode=require&connection_limit=3

PROD_DATABASE_SECRET_ID=
# DATABASE_URL_PROD=

# Terraform stack uses ECS Fargate. Keep ecs unless you built App Runner yourself.
WEB_COMPUTE=ecs

# App Runner
APPRUNNER_SERVICE_ARN_STAGING=
APPRUNNER_SERVICE_ARN_PROD=

# ECS (if WEB_COMPUTE=ecs)
ECS_CLUSTER=coupon-hub
ECS_SERVICE_STAGING=coupon-hub-web-staging
ECS_SERVICE_PROD=coupon-hub-web-prod

# Smoke extras (staging demo catalog)
SMOKE_STORE_SLUG=nike
# SMOKE_OFFER_ID=
